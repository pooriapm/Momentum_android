# Copy to momentum.properties (git-ignored) and fill in.
# Website, used only for setup steps the app does not have yet.
siteUrl=https://momentum.pooria-pm.workers.dev

# Same Supabase project as the website (Momentum/supabase).
supabaseUrl=https://YOUR_PROJECT.supabase.co
supabaseAnonKey=YOUR_PUBLIC_ANON_KEY

# Cafe Bazaar developer panel → in-app billing.
# The RSA key lets Poolakey check purchase signatures on the device; the server
# still validates every purchase before granting membership.
bazaarRsaKey=YOUR_BAZAAR_RSA_PUBLIC_KEY
# Must equal BAZAAR_PRODUCT_ID on the server (consumable, 490,000 toman).
bazaarProductId=membership_month

# Optional, debug builds only: serve exercise animations and the library from a local server
# (default: <supabaseUrl>/storage/v1/object/public/exercise-media/v1/), e.g. on the emulator:
# python -m http.server 8765 --directory media, then http://10.0.2.2:8765/exercise/v1/
exerciseMediaUrl=

# Release signing (Cafe Bazaar). Create the keystore once with keytool, keep it and its passwords
# backed up: every future update must be signed with the same key.
releaseStoreFile=momentum-release.jks
releaseStorePassword=YOUR_STORE_PASSWORD
releaseKeyAlias=momentum
releaseKeyPassword=YOUR_KEY_PASSWORD
